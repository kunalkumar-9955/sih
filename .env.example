# ============================================================
# SIH26002 — Environment Variable Template
# Copy to .env and fill in your values. NEVER commit .env to version control.
# ============================================================

# ── Django Core ────────────────────────────────────────────
SECRET_KEY=CHANGE-ME-USE-A-LONG-RANDOM-STRING
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development

# ── Database (PostgreSQL with PostGIS Extension) ────────────
# Local Windows Default: localhost:5432
POSTGRES_DB=sih_db
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=sih_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgis://sih_user:sih_pass@localhost:5432/sih_db

# ── Redis (Optional for local dev, used for Celery) ────────
REDIS_URL=redis://localhost:6379/0

# ── Celery (Optional background task queue) ────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── JWT Authentication ─────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=CHANGE-ME-JWT-SIGNING-KEY

# ── CORS Configuration ─────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Routing Engine Parameters ──────────────────────────────
# alpha: geohazard penalty multiplier in Dijkstra routing
# Weight(e) = BaseTransitTime(e) × (1 + alpha × HazardScore(e)) + TransferPenalty(e)
ROUTING_HAZARD_ALPHA=1.5
# threshold above which a segment is flagged as high-hazard (0.0 to 1.0)
ROUTING_HAZARD_THRESHOLD=0.7
# intermodal transfer penalty (minutes) for Road <-> Rail <-> Water
ROUTING_TRANSFER_PENALTY_MIN=30

# ── Feature Flags ──────────────────────────────────────────
ENABLE_SPATIAL_GCN=false
ENABLE_IVR=false
ENABLE_USSD=false
ENABLE_RATE_LIMITING=true

# ── Observability & Logging ────────────────────────────────
LOG_LEVEL=INFO

# ── Map & Geospatial Tiles ─────────────────────────────────
# Standard OpenStreetMap tile server (no external API key required)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Driver Notifications (Mock providers active by default) ─
SMS_PROVIDER=mock
IVR_PROVIDER=mock
USSD_PROVIDER=mock

# ── Super Admin Initial Credentials ────────────────────────
SUPER_ADMIN_EMAIL=admin@sih26002.in
SUPER_ADMIN_PASSWORD=CHANGE-ME-SUPER-ADMIN-PASSWORD

# ── Government Data Integrations (Configured Domain Telemetry) ──
# IMD Weather (Regional Automatic Weather Stations)
IMD_API_ENDPOINT=https://api.imd.gov.in/aws/v1
IMD_API_KEY=YOUR-IMD-API-KEY-OR-MOCK

# ISRO Bhuvan (CartoDEM & Geospatial)
BHUVAN_PORTAL_URL=https://bhuvan-app1.nrsc.gov.in/api/v2
BHUVAN_API_KEY=YOUR-BHUVAN-API-TOKEN-OR-MOCK

# Copernicus Sentinel-1 InSAR Ground Deformation
COPERNICUS_DATASPACETOKEN=YOUR-COPERNICUS-ACCESS-TOKEN

# PM Gati Shakti GIS & FOIS Freight Integration
GATI_SHAKTI_GIS_ENDPOINT=https://gatishakti.nic.in/api/v1
FOIS_FREIGHT_ENDPOINT=https://fois.indianrailways.gov.in/api/v1

# IWAI National Waterway-2 River Gauge Services
IWAI_NW2_PORTAL=https://iwai.nic.in/nw2/gauge-api

# ── Demo Scenario Engine ───────────────────────────────────
ENABLE_DEMO_SCENARIO_ENGINE=true
ALLOW_CLIENT_SCENARIO_OVERRIDE=true
DEMO_RANDOM_SEED=42

# ── Frontend Configuration (Next.js) ───────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Internal ───────────────────────────────────────────────
API_VERSION=v1
